name: Verify ARMv7 installer
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  install:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      - uses: docker/setup-qemu-action@99012661954931238ded8c8b007157a8430204e1
        with:
          platforms: arm
      - name: Check shell
        run: |
          bash -n install.sh
          shellcheck install.sh
      - name: Download candidate image
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release download v0.3.0-beta.7-install.1 --pattern '*.tar.gz' --dir "$RUNNER_TEMP/package"
      - name: Install and verify guards, update and rollback under ARM emulation
        run: bash tests/verify-install.sh "$RUNNER_TEMP/package/reikjv-snav-0.3.0-beta.7-armv7.tar.gz"
